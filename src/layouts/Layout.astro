---
import "../styles/global.css";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
const { active } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="View the top requested animals for Planet Zoo 2, voted on by the community."
        />
        <Font cssVariable="--font-noto-sans" />
        <Font cssVariable="--font-eagle-bold" />
        <title>PZ2 Species Wishlist</title>
    </head>
    <body>
        <Navbar active={active} />
        <main>
            <div class="">
                <div class="title-header">
                    <h1>Planet Zoo 2 Species Wishlist</h1>
                    <p class="subtitle">Data from: -</p>
                    <div class="nav-group right no-grow show-small">
                        <a class="nav-button disabled" href="#link">
                            Vote here
                        </a>
                    </div>
                </div>
            </div>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        width: 100%;
        height: 100%;
        min-height: 100svh;
        display: grid;
        grid-template-rows: auto 1fr auto;

        margin: 0 auto;
        padding-inline: var(--spacing-07);
        padding-block: var(--spacing-08);
        box-sizing: border-box;
    }
    main {
        max-width: 80rem;
        width: 100%;
        margin-inline: auto;
        margin-bottom: var(--spacing-11);
    }
    .title-header {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .subtitle {
        text-align: center;
        font-size: var(--type-01);
        color: var(--text-soft);
    }
    .nav-group {
        list-style: none;
        margin: 0;
        padding: 0;
        justify-content: center;
        flex-basis: 20%;
        display: flex;
        flex-grow: 1;
        align-items: center;
        gap: var(--spacing-06);
        &.large {
            flex-basis: 60%;
        }
        &.right {
            justify-content: flex-end;
        }
        &.left {
            justify-content: flex-start;
        }
    }
    .nav-link {
        color: var(--text-normal);
        transition:
            color,
            background-color 0.2s ease-in-out;
        text-decoration: none;
        padding: var(--spacing-04) var(--spacing-05);
        border-radius: var(--radii-m);
        &:hover {
            background-color: var(--bg-2);
        }
        &.active {
            background-color: var(--bg-2);
        }
    }
    .show-small {
        display: none;
    }
    .nav-button {
        margin-top: var(--spacing-03);
        padding: var(--spacing-04) var(--spacing-05);
        background-color: var(--green);
        border: 4px solid var(--dark-green);
        border-radius: var(--radii-m);
        color: var(--text-white);
        font-size: var(--type-05);
        align-self: center;
        line-height: var(--spacing-06);
        font-family: var(--font-eagle-bold);
        transition: background-color 200ms ease-in-out;
        &.disabled {
            opacity: 0.5;
            background-color: var(--bg-2);
            border-color: var(--text-soft);
            color: var(--text-soft);
        }
        &.disabled:hover {
            opacity: 0.5;
            background-color: var(--bg-2);
            border-color: var(--text-soft);
            color: var(--text-soft);
            cursor: default;
        }
        &:hover {
            background-color: var(--dark-green);
        }
        text-decoration: none;
        &.right {
            justify-self: flex-end;
        }
    }
    @media (width < 600px) {
        .show-small {
            display: flex;
        }
    }
    @media (width < 500px) {
        body {
            padding-inline: var(--spacing-05);
            padding-block: var(--spacing-05);
        }
        h1 {
            font-size: var(--type-10);
            line-height: var(--spacing-8);
        }
    }
</style>
