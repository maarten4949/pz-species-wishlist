---
const { active } = Astro.props;
---

<nav class="nav">
    <div class="nav-group left">
        <a class={`nav-link${active == "home" ? " active" : ""}`} href="/">
            Meta-wishlist
        </a>
        <a
            class={`nav-link${active == "newatzoo" ? " active" : ""}`}
            href="/new-at-the-zoo"
        >
            New at the zoo
        </a>
    </div>
    <div class="nav-group right no-grow hide-small">
        <a class="nav-button disabled" href="#link">
            Vote here
        </a>
    </div>
</nav>

<style>
    .nav {
        display: flex;
        justify-content: space-between;
        gap: var(--spacing-06);
        margin-bottom: var(--spacing-07);
    }
    .nav-group {
        list-style: none;
        margin: 0;
        padding: 0;
        justify-content: center;
        flex-basis: 20%;
        display: flex;
        flex-grow: 1;
        align-items: center;
        gap: var(--spacing-06);
        &.large {
            flex-basis: 60%;
        }
        &.right {
            justify-content: flex-end;
        }
        &.left {
            justify-content: flex-start;
        }
    }
    .nav-link {
        color: var(--text-normal);
        transition:
            color,
            background-color 0.2s ease-in-out;
        text-decoration: none;
        padding: var(--spacing-04) var(--spacing-05);
        border-radius: var(--radii-m);
        &:hover {
            background-color: var(--bg-2);
        }
        &.active {
            background-color: var(--bg-2);
        }
    }
    .nav-button {
        padding: var(--spacing-04) var(--spacing-05);
        background-color: var(--green);
        border: 4px solid var(--dark-green);
        border-radius: var(--radii-m);
        color: var(--text-white);
        font-size: var(--type-05);
        align-self: center;
        line-height: var(--spacing-06);
        font-family: var(--font-eagle-bold);
        transition: background-color 200ms ease-in-out;
        &.disabled {
            opacity: 0.5;
            background-color: var(--bg-2);
            border-color: var(--text-soft);
            color: var(--text-soft);
        }
        &.disabled:hover {
            opacity: 0.5;
            background-color: var(--bg-2);
            border-color: var(--text-soft);
            color: var(--text-soft);
            cursor: default;
        }
        &:hover {
            background-color: var(--dark-green);
        }
        text-decoration: none;
        &.right {
            justify-self: flex-end;
        }
    }
    @media (width < 600px) {
        .hide-small {
            display: none;
        }
        .nav-group {
            justify-content: center;
            &.right {
                justify-content: center;
            }
            &.left {
                justify-content: center;
            }
        }
        .nav {
            flex-direction: column;
        }
    }
    @media (width < 400px) {
        .nav-group {
            align-items: center;
        }
        .nav {
            align-items: center;
            flex-direction: column;
        }
    }
    @media (width < 1000px) {
        .nav {
            & .nav-group {
                flex-basis: 0;
                &.none {
                    display: none;
                }
                &.no-grow {
                    flex-grow: 0;
                    min-width: max-content;
                }
            }
        }
    }
</style>
