---
import AnimalList from "../components/AnimalList.vue";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Planet Zoo 2 Guessing Game">
    <div class="title-header">
        <h1>Planet Zoo 2 Species Wishlist</h1>
        <p class="subtitle">Data last updated: 27/09/2026</p>
    </div>
    <AnimalList client:load />
</Layout>

<style>
    .title-header {
        margin-bottom: var(--spacing-08);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    h1 {
    }
    .subtitle {
        text-align: center;
        font-size: var(--type-01);
        color: var(--text-soft);
    }
</style>
